---
import Navbar from "./Navbar.astro";
---

<header class="hero">
  <div class="contenitore">
    <Navbar />

    <div class="hero__griglia">
      <div class="hero__testo">
        <!-- Un solo h1: prima erano due, e una pagina con due titoli di
             primo livello non ha una gerarchia leggibile. -->
        <h1 class="titolone">
          Andrea Messina<br />
          <span class="titolone__mestiere">Web designer</span>
        </h1>

        <p class="hero__claim">Creo il racconto della tua identità, online e offline.</p>

        <a class="btn-contorno hero__azione" href="/lavoriamo"
          >progettiamo<br />il tuo sito</a
        >
      </div>

      <div class="hero__immagine">
        <img
          src="/img/anselmo-hero.webp"
          alt="Anselmo, la mascotte di Andrea Messina"
          width="500"
          height="500"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-block: 3% 80px;
    height: 100vh;
  }

  .hero__griglia {
    display: grid;
    /* minmax(0, 1fr) lascia che la colonna si restringa sotto la
       larghezza del titolo: così il testo sconfina sopra la mascotte,
       come nel design, invece di andare a capo. */
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: start;
    margin-top: 5%;
  }

  .hero__testo {
    position: relative;
    z-index: 1;
  }

  .hero__testo .titolone {
    white-space: nowrap;
  }

  /* em e non px: cresce insieme al titolo, che è fluido */
  .titolone__mestiere {
    display: inline-block;
    font-size: 1.2em;
  }

  .hero__claim {
    font-family: var(--f-accent);
    /* Corpo proprio, più piccolo del sottotitolo condiviso: accanto
       ad Anselmo restano 657px, e a 36px la prima metà della frase ne
       chiedeva 797, quindi andava a capo in mezzo a "della tua". */
    font-size: clamp(18px, 0.7rem + 1.2vw, 27px);
    line-height: 1.2;
    color: var(--c-terracotta);
    margin-top: 48px;
  }

  /* Aspetto in .btn-contorno (global.css): qui solo la misura
     che questo bottone ha nel design dell'hero. */
  .hero__azione {
    margin-top: 48px;
    padding: 5px 8px;
  }

  .hero__immagine {
    position: relative;
  }

  .hero__immagine img {
    /* elastica: non supera i 597px del Figma ma si restringe
       quando lo schermo non li concede */
    width: clamp(220px, 42vw, 597px);
    height: auto;
    /* riserva lo spazio prima che l'immagine arrivi:
       niente salto di layout, niente alt text lampeggiante */
    aspect-ratio: 500 / 500;
  }


  /* ---------- Schermi stretti ---------- */
  @media (max-width: 860px) {
    .hero {
      height: auto; /* il 100vh soffoca il contenuto sui telefoni */
      padding-block: 24px 60px;
    }

    .hero__griglia {
      grid-template-columns: 1fr; /* testo sopra, mascotte sotto */
      gap: 24px;
      margin-top: 32px;
    }

    /* niente piu' sconfinamento: a una colonna il titolo puo' andare a capo */
    .hero__testo .titolone {
      white-space: normal;
    }

    .hero__claim {
      margin-top: 28px;
    }
    .hero__azione {
      margin-top: 28px;
    }

    .hero__immagine {
      display: flex;
      flex-direction: column; /* la scritta sopra, la mascotte sotto */
      align-items: center;
    }

    .hero__immagine img {
      width: min(78vw, 360px);
    }

  }
</style>
