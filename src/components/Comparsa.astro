---
// Avvolge un contenuto e lo fa comparire quando entra nello schermo.
//   direzione: 'basso' | 'alto' | 'sinistra' | 'destra' | 'dissolvenza'
//   ritardo:   millisecondi di attesa dopo l'ingresso
// attendiScroll: anche se l'elemento e' gia' in vista al caricamento,
// non compare finche' la persona non scorre almeno una volta.
const {
  direzione = 'basso',
  ritardo = 0,
  attendiScroll = false,
  class: classe = '',
} = Astro.props;
---

<div
  class:list={['comparsa', `comparsa--${direzione}`, classe]}
  style={`--ritardo: ${ritardo}ms;`}
  data-attendi-scroll={attendiScroll ? '' : undefined}
>
  <slot />
</div>

<style>
  .comparsa {
    opacity: 0;
    transition:
      opacity 0.7s ease var(--ritardo),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--ritardo);
    will-change: opacity, transform;
  }

  .comparsa--basso     { transform: translateY(80px); }
  .comparsa--alto      { transform: translateY(-80px); }
  .comparsa--dissolvenza { transform: none; }

  /* Le entrate laterali non possono scostarsi piu' del margine del
     sito, altrimenti un elemento a tutta larghezza sporge dal bordo
     e la finestra prende una barra di scorrimento orizzontale finche'
     l'animazione non finisce. Il margine e' il 6% della finestra:
     5vw sta sempre dentro, e sopra i 1600px torna agli 80px pieni. */
  .comparsa--sinistra  { transform: translateX(calc(-1 * min(80px, 5vw))); }
  .comparsa--destra    { transform: translateX(min(80px, 5vw)); }

  .comparsa.visibile {
    opacity: 1;
    transform: none;
  }

  /* Su schermo stretto le entrate laterali diventano verticali:
     di lato lo spazio non c'e' e il movimento si legge male. */
  @media (max-width: 900px) {
    .comparsa--sinistra,
    .comparsa--destra { transform: translateY(50px); }
  }

  /* Senza JavaScript la classe .visibile non arriva mai e il
     contenuto resterebbe trasparente per sempre: su una pagina il
     guasto peggiore possibile. Qui parte visibile, senza entrata. */
  @media (scripting: none) {
    .comparsa {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Chi ha chiesto meno animazioni al sistema operativo
     vede tutto subito, senza movimento. */
  @media (prefers-reduced-motion: reduce) {
    .comparsa {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
