---
import { pezzi } from '../data/su-di-me.js';

// Le coordinate nel file dati sono in pixel sulla tela del Figma (1440x1024).
// Qui diventano percentuali, cosi' i pezzi si ridimensionano insieme alla tela
// invece di restare ancorati a una misura fissa.
const TELA_W = 1440;
const TELA_H = 1024;
const pc = (v, base) => `${((v / base) * 100).toFixed(4)}%`;
---

<section class="su-di-me" id="chi-sono">
  <h2 class="titolo-sezione">SU DI ME</h2>

  <div class="contenuto">
    <!-- A sinistra la frase, fuori dal collage: e' il manifesto,
         deve leggersi subito e non dipendere da un hover. -->
    <blockquote class="manifesto">
      <p>
        Sono convinto che essere creativi e distinguersi sia il modo giusto per
        affrontare il mio lavoro, ma non solo. In un mondo che si affaccia sempre
        più all&rsquo;IA conservare il lato umano, artistico ci contraddistingue
        dalla massa.
      </p>
    </blockquote>

    <!-- A destra i ritagli: vivono su una tela di 1440x1024 con le
         coordinate esatte del Figma. Il gruppo intero viene poi
         rimpicciolito dal fattore --scala, senza toccare il titolo. -->
    <div class="collage">
      <div class="pezzi">
        {pezzi.map((p) => (
          <figure
            class="pezzo"
            tabindex="0"
            style={`
              --x: ${pc(p.x, TELA_W)};
              --y: ${pc(p.y, TELA_H)};
              --w: ${pc(p.w, TELA_W)};
              --h: ${pc(p.h, TELA_H)};
              --rot: ${p.rot}deg;
              --z: ${p.z};
            `}
          >
            <img src={p.immagine} alt={p.alt} loading="lazy" />

            <!-- area sensibile: ricalca il disegno, non il riquadro -->
            <span
              class="zona"
              style={`
                left: ${(p.zona.x0 * 100).toFixed(2)}%;
                top: ${(p.zona.y0 * 100).toFixed(2)}%;
                width: ${((p.zona.x1 - p.zona.x0) * 100).toFixed(2)}%;
                height: ${((p.zona.y1 - p.zona.y0) * 100).toFixed(2)}%;
              `}
            ></span>

            <figcaption class="popup">
              <p>{p.testo}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .su-di-me {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: var(--margine-lato);

    /* clip, non hidden: taglia solo in orizzontale (su telefono un
       pop-up sporgerebbe oltre il bordo e creerebbe lo scroll
       laterale) e lascia liberi i pop-up di scendere in verticale. */
    overflow-x: clip;
  }

  .titolo-sezione {
    margin: 5vh 0 2vh;
    font-family: var(--f-shade);
    font-size: var(--t-sezione);
    font-weight: 400;
    line-height: 1;
    color: var(--c-terracotta);
    white-space: nowrap;
  }

  /* La riga: frase a sinistra, collage a destra.
     min-height:0 serve perche' un figlio flex, di suo, non scende
     mai sotto la sua altezza naturale e sfonderebbe il 100vh. */
  .contenuto {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    gap: 4%;

    /* Lo spazio in fondo non e' decorativo: i pop-up si aprono sotto
       le grafiche e senza questo margine verrebbero tagliati dal
       bordo della sezione. */
    padding-bottom: clamp(110px, 25vh, 200px);
  }

  /* ----- Il manifesto ----- */
  .manifesto {
    flex: 0 0 30%;
    margin: 0;
    padding: clamp(20px, 1.6vw, 30px);
    background: var(--c-sfondo);
    border: 3px solid var(--c-nero);
    box-shadow: -6px 6px 0 var(--c-ombra-bottone);
    font-family: var(--f-testo);
    font-size: var(--t-testo);
    line-height: 1.5;
    color: var(--c-testo);
  }

  .manifesto p {
    margin: 0;
  }

  /* ----- Il collage ----- */
  .collage {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;

    /* Quanto sono rimpicciolite le immagini: 1 = larghezza piena
       della colonna. Abbassalo per rimpicciolirle. */
    --scala: 0.92;
  }

  .pezzi {
    position: relative;
    width: 100%;

    /* aspect-ratio tiene le proporzioni interne del collage: senza,
       una percentuale orizzontale e una verticale si riferirebbero
       a misure scorrelate e i pezzi si stirerebbero. */
    aspect-ratio: 1440 / 1024;

    transform: scale(var(--scala)) translateY(-6%);
  }

  /* ----- I ritagli ----- */
  .pezzo {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    z-index: var(--z);
    margin: 0;
    /* il riquadro non reagisce al mouse: reagisce solo .zona */
    pointer-events: none;
    transform: rotate(var(--rot));
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .pezzo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .zona {
    position: absolute;
    pointer-events: auto;
    cursor: pointer;
  }

  .pezzo:has(.zona:hover),
  .pezzo:focus-visible {
    transform: rotate(var(--rot)) translateY(-20px) scale(1.03);
    filter: drop-shadow(0 12px 16px rgba(0, 0, 0, 0.25));
    z-index: 20;
    outline: none;
  }

  /* ----- Il pop-up ----- */
  .popup {
    position: absolute;
    left: 50%;
    top: 100%;   /* subito sotto la grafica */
    /* il testo non deve rimpicciolirsi insieme alle immagini:
       la divisione per --scala annulla la riduzione del gruppo */
    width: calc(400px / var(--scala));
    padding: calc(16px / var(--scala)) calc(20px / var(--scala));
    transform: translate(-50%, calc(12px / var(--scala)))
               rotate(calc(var(--rot) * -1));
    background: var(--c-sfondo);
    border: 2px solid var(--c-nero);
    box-shadow: -4px 4px 0 var(--c-nero);
    font-family: var(--f-testo);
    font-size: calc(16px / var(--scala));
    line-height: 1.4;
    color: var(--c-testo);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
  }

  .pezzo:has(.zona:hover) .popup,
  .pezzo:focus-visible .popup {
    opacity: 1;
    visibility: visible;
  }

  .popup p {
    margin: 0;
    /* pre-line: gli a capo scritti nel testo diventano a capo veri */
    white-space: pre-line;
  }

  /* ---------- Schermi stretti ----------
     Le due colonne non ci stanno piu' affiancate: la frase va sopra,
     i ritagli sotto, e la sezione smette di essere alta 100vh
     perche' altrimenti dovrebbe comprimere entrambi. */
  @media (max-width: 860px) {
    .su-di-me {
      height: auto;
      padding-block: 40px 60px;
    }

    .titolo-sezione {
      white-space: normal;
      margin-bottom: 16px;
    }

    .contenuto {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }

    .manifesto {
      flex: 0 0 auto;
    }

    .collage {
      height: auto;
      /* 1 = la tela occupa esattamente la larghezza dello schermo. */
      --scala: 1;
    }

    /* il pop-up non deve uscire dallo schermo */
    .popup {
      width: min(74vw, calc(400px / var(--scala)));
    }
  }
</style>
