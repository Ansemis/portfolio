---
import { pezzi } from '../data/su-di-me.js';

// Le coordinate nel file dati sono in pixel sulla tela del Figma (1440x1024).
// Qui diventano percentuali, così i pezzi si ridimensionano insieme alla tela
// invece di restare ancorati a una misura fissa.
const TELA_W = 1440;
const TELA_H = 1024;
const pc = (v, base) => `${((v / base) * 100).toFixed(4)}%`;
---

<section class="su-di-me" id="chi-sono">
  <div class="collage">
    <h2 class="titolo-sezione">SU DI ME</h2>

    <!-- I ritagli vivono su una tela di 1440x1024 con le coordinate
         esatte del Figma. Il gruppo intero viene poi rimpicciolito
         dal fattore --scala, senza toccare il titolo. -->
    <div class="pezzi">
      {pezzi.map((p) => (
        <figure
          class="pezzo"
          tabindex="0"
          style={`
            --x: ${pc(p.x, TELA_W)};
            --y: ${pc(p.y, TELA_H)};
            --w: ${pc(p.w, TELA_W)};
            --h: ${pc(p.h, TELA_H)};
            --rot: ${p.rot}deg;
            --z: ${p.z};
          `}
        >
          <img src={p.immagine} alt={p.alt} loading="lazy" />

          <!-- area sensibile: ricalca il disegno, non il riquadro -->
          <span
            class="zona"
            style={`
              left: ${(p.zona.x0 * 100).toFixed(2)}%;
              top: ${(p.zona.y0 * 100).toFixed(2)}%;
              width: ${((p.zona.x1 - p.zona.x0) * 100).toFixed(2)}%;
              height: ${((p.zona.y1 - p.zona.y0) * 100).toFixed(2)}%;
            `}
          ></span>

          <figcaption class="popup">
            <p>{p.testo}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .su-di-me {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .collage {
    position: relative;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;

    /* Quanto sono rimpicciolite le immagini: 1 = larghezza piena.
       Abbassalo per rimpicciolirle ancora, alzalo per ingrandirle. */
    --scala: 0.7;

  }

  .titolo-sezione {
    position: absolute;
    left: var(--margine-lato);
    top: 3%;
    z-index: 30;
    margin: 0;
    font-family: var(--f-shade);
    font-size: var(--t-sezione);
    font-weight: 400;
    line-height: 1;
    color: var(--c-terracotta);
    white-space: nowrap;
  }

  /* Il gruppo dei ritagli: tela originale, rimpicciolita in blocco
     e centrata nella sezione. */
  .pezzi {
    position: absolute;
    left: 50%;
    top: 40%;
    
    /* La tela si adatta alla LARGHEZZA dello schermo.
       aspect-ratio tiene le proporzioni interne del collage: senza,
       una percentuale orizzontale e una verticale si riferirebbero
       a misure scorrelate e i pezzi si stirerebbero. */
    width: 100%;
    aspect-ratio: 1440 / 1024;

    transform: translate(-50%, -50%) scale(var(--scala));
  }

  /* ----- I ritagli ----- */
  .pezzo {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    z-index: var(--z);
    margin: 0;
    /* il riquadro non reagisce al mouse: reagisce solo .zona */
    pointer-events: none;
    transform: rotate(var(--rot));
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .pezzo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  /* il riquadro ha già misure fisse: l'alt text non compare mai */

  .zona {
    position: absolute;
    pointer-events: auto;
    cursor: pointer;
  }

  .pezzo:has(.zona:hover),
  .pezzo:focus-visible {
    transform: rotate(var(--rot)) translateY(-20px) scale(1.03);
    filter: drop-shadow(0 12px 16px rgba(0, 0, 0, 0.25));
    z-index: 20;
    outline: none;
  }

  /* ----- Il pop-up ----- */
  .popup {
    position: absolute;
    left: 50%;
    top: 100%;   /* subito sotto la grafica */
    /* il testo non deve rimpicciolirsi insieme alle immagini:
       la divisione per --scala annulla la riduzione del gruppo */
    width: calc(300px / var(--scala));
    padding: calc(16px / var(--scala)) calc(20px / var(--scala));
    transform: translate(-50%, calc(12px / var(--scala)))
               rotate(calc(var(--rot) * -1));
    background: var(--c-sfondo);
    border: 2px solid var(--c-nero);
    box-shadow: -4px 4px 0 var(--c-nero);
    font-family: var(--f-testo);
    font-size: calc(16px / var(--scala));
    line-height: 1.4;
    color: var(--c-testo);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
  }

  .pezzo:has(.zona:hover) .popup,
  .pezzo:focus-visible .popup {
    opacity: 1;
    visibility: visible;
  }

  .popup p { margin: 0; }

  /* ---------- Schermi stretti ----------
     Il collage e' tarato su una tela larga: su un telefono i ritagli
     diventerebbero francobolli e il titolo li coprirebbe. Qui il
     gruppo si ingrandisce (occupa piu' della larghezza) e scende
     sotto il titolo, che non e' piu' sovrapposto. */
  @media (max-width: 860px) {
    .su-di-me {
      height: auto;
      min-height: 72vh;
      padding-block: 40px 60px;
    }

    .collage {
      height: auto;
      /* 1 = la tela occupa esattamente la larghezza dello schermo.
         Sopra 1 i ritagli vengono tagliati ai lati. */
      --scala: 1;
    }

    .titolo-sezione {
      position: static;
      padding-inline: var(--margine-lato);
      white-space: normal;
      margin-bottom: 12px;
    }

    .pezzi {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      margin-inline: auto;
    }

    /* il pop-up non deve uscire dallo schermo */
    .popup {
      width: min(74vw, calc(300px / var(--scala)));
    }
  }

</style>
