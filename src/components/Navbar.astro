---
// Navbar: la pillola con i tre link. Usata in tutte le pagine.
const voci = [
  { testo: 'Progetti',  href: '/#progetti' },
  { testo: 'Lavoriamo', href: '/lavoriamo' },
  { testo: 'Chi sono',  href: '/#chi-sono' },
];
---

<div class="navbar-riga">
  <a class="navbar__mascotte" href="/" aria-label="Torna alla home">
    <img
      src="/img/anselmo-hero.webp"
      alt="Anselmo, la mascotte di Andrea Messina"
      width="500"
      height="500"
      fetchpriority="high"
      decoding="async"
    />
  </a>

  <nav class="navbar" aria-label="Navigazione principale">
    {voci.map((voce, i) => (
      <>
        {i > 0 && <span class="separatore" aria-hidden="true"></span>}
        <a href={voce.href}>{voce.testo}</a>
      </>
    ))}
  </nav>
</div>

<style>
  /* La riga: mascotte a sinistra, pillola centrata nella pagina.
     La mascotte è in posizione assoluta così non sposta il centro. */
  .navbar-riga {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100px;
  }

  .navbar__mascotte {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    display: block;
    width: 79px;
  }

  .navbar__mascotte img {
    width: 100%;
    height: auto;
    aspect-ratio: 500 / 500;
    transform: scaleX(-1);   /* specchiata, come nel footer */
    transition: transform 0.2s ease;
  }

  .navbar__mascotte:hover img { transform: scaleX(-1) translateY(-4px); }





  /* ---------- Schermi stretti ---------- */
  @media (max-width: 700px) {
    /* Anselmo resta in riga accanto alla pillola, ma esce dal
       posizionamento assoluto: in flusso non puo' sovrapporsi ai link. */
    .navbar-riga {
      min-height: 0;
      gap: 10px;
    }

    .navbar__mascotte {
      position: static;
      transform: none;
      width: 42px;
      flex-shrink: 0;
    }

    .navbar__mascotte:hover img { transform: scaleX(-1) translateY(-3px); }

    .navbar { padding: 8px 10px; gap: 8px; }
  }

  @media (max-width: 430px) {
    .navbar-riga { gap: 8px; }
    .navbar__mascotte { width: 34px; }
    .navbar { padding: 7px 9px; gap: 7px; }
  }
</style>