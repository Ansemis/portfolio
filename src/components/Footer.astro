---
import { contatti } from '../data/contatti.js';
---

<footer class="footer">
  <div class="contenitore footer__griglia">
    <a class="footer__mascotte" href="/" aria-label="Torna alla home">
      <img
        src="/img/anselmo-hero.webp"
        alt="Anselmo, la mascotte di Andrea Messina"
        width="79"
        height="100"
        loading="lazy"
      />
    </a>

    <!-- ===== Contatti ===== -->
    <div class="footer__gruppo footer__gruppo--contatti">
      <h2 class="footer__titolo">Contatti</h2>

      <ul class="footer__voci">
        <li>
          <a href={`mailto:${contatti.email}`}>
            <svg viewBox="0 0 128.6 81.15" aria-hidden="true" focusable="false">
              <path fill="currentColor" stroke="currentColor" stroke-miterlimit="10" stroke-width="2" d="M122.18,1H6.42C3.43,1,1,3.43,1,6.42v67.98c0,3.17,2.57,5.75,5.75,5.75h115.1c3.18,0,5.75-2.58,5.75-5.75V6.42C127.6,3.43,125.17,1,122.18,1ZM110.79,4l-45.88,45.81L17.87,4H110.79ZM124.6,71.4c0,3.17-2.57,5.75-5.75,5.75H9.75c-3.18,0-5.75-2.58-5.75-5.75V6.41c0-1.33,1.08-2.41,2.41-2.41h7.47l51.05,49.71L114.72,4h7.48c1.32,0,2.4,1.08,2.4,2.41V71.4Z" />
              </svg>
            {contatti.email}
          </a>
        </li>

        <li>
          <a href={contatti.instagram.url} target="_blank" rel="noopener noreferrer">
            <svg viewBox="-2 -2 188.1 188.1" aria-hidden="true" focusable="false">
              <path fill="currentColor" stroke="currentColor" stroke-miterlimit="10" stroke-width="3" d="M92.5,137c-25.4,0-46.1-20.7-46.1-46.1s20.7-46.1,46.1-46.1,46.1,20.6,46.1,46.1S118,137,92.5,137ZM92.5,55.9c-19.3,0-34.9,15.7-34.9,35s15.6,34.9,34.9,34.9,35-15.6,35-34.9S111.8,55.9,92.5,55.9Z" />
              <path fill="currentColor" stroke="currentColor" stroke-miterlimit="10" stroke-width="3" d="M127.2,184.1H56.9c-31.4,0-56.9-25.5-56.9-56.9V56.9C0,25.5,25.5,0,56.9,0h70.3c31.4,0,56.9,25.5,56.9,56.9v70.3C184.1,158.6,158.6,184.1,127.2,184.1ZM56.9,11.2c-25.2,0-45.7,20.5-45.7,45.7v70.3c0,25.2,20.5,45.8,45.7,45.8h70.3c25.2,0,45.8-20.6,45.8-45.8V56.9c0-25.2-20.6-45.7-45.8-45.7C127.2,11.2,56.9,11.2,56.9,11.2Z" />
              <circle fill="currentColor" stroke="currentColor" stroke-miterlimit="10" stroke-width="3" cx="141.6" cy="41.3" r="10.7" />
              </svg>
            {contatti.instagram.etichetta}
          </a>
        </li>

        <li>
          {contatti.linkedin.url
            ? <a href={contatti.linkedin.url} target="_blank" rel="noopener noreferrer">
                <svg viewBox="-7 -7 225 211.5" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M61.35,45.04c0-9.21-7.46-16.67-16.66-16.67s-16.67,7.46-16.67,16.67,7.46,16.67,16.67,16.67S61.35,54.24,61.35,45.04ZM135.35,103.6c2.74,4.86,2.84,10.84,2.99,16.53v47.03s28.71,0,28.71,0v-54.02c-.29-8.77-.99-17.19-4.62-25.11-6.21-13.53-20.33-16.8-34.3-15.62-5.92.75-11.3,2.9-15.94,6.53-2.98,2.33-5,4.96-7.26,8.47l-.14-12.95h-27.57s0,92.7,0,92.7h28.72s0-46.52,0-46.52c.06-9.37,1.74-20.05,11.67-22.51C124.25,96.5,131.84,97.37,135.35,103.6ZM59.05,74.46h-28.78v92.69h28.78V74.46Z" />
              <path fill="currentColor" d="M211,162.29v1.99c-.69,2.7-3.15,4.43-5.86,4.14s-4.67-2.59-4.62-5.27,2.11-4.9,4.85-5.1S210.36,159.66,211,162.29ZM210.15,163.25c0-2.44-1.98-4.42-4.41-4.42s-4.42,1.98-4.42,4.42,1.98,4.41,4.42,4.41S210.15,165.68,210.15,163.25Z" />
              <path fill="currentColor" d="M208.07,165.98c-1.79.36-1.42-2.52-3.29-2.43l-.03,2.42h-.79s-.01-5.48-.01-5.48l2.36-.02c.77,0,1.56.54,1.67,1.19.15.91-.21,1.71-1.41,1.93L208.07,165.98ZM206.96,162.79c.19-.38.14-1.43-.21-1.47l-1.96-.22-.05,1.93L206.96,162.79Z" />
              <path fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="14" d="M183.22,1.5c6.75,1.14,12.64,6.43,12.64,13.63v167.22c0,7.13-5.84,12.57-12.72,13.64H14.13c-6.55-.99-11.7-5.73-12.63-12.28V13.78C2.44,7.15,7.62,2.56,14.05,1.5h169.17Z" />
              </svg>
                {contatti.linkedin.etichetta}
              </a>
            : <span>
                <svg viewBox="-7 -7 225 211.5" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M61.35,45.04c0-9.21-7.46-16.67-16.66-16.67s-16.67,7.46-16.67,16.67,7.46,16.67,16.67,16.67S61.35,54.24,61.35,45.04ZM135.35,103.6c2.74,4.86,2.84,10.84,2.99,16.53v47.03s28.71,0,28.71,0v-54.02c-.29-8.77-.99-17.19-4.62-25.11-6.21-13.53-20.33-16.8-34.3-15.62-5.92.75-11.3,2.9-15.94,6.53-2.98,2.33-5,4.96-7.26,8.47l-.14-12.95h-27.57s0,92.7,0,92.7h28.72s0-46.52,0-46.52c.06-9.37,1.74-20.05,11.67-22.51C124.25,96.5,131.84,97.37,135.35,103.6ZM59.05,74.46h-28.78v92.69h28.78V74.46Z" />
              <path fill="currentColor" d="M211,162.29v1.99c-.69,2.7-3.15,4.43-5.86,4.14s-4.67-2.59-4.62-5.27,2.11-4.9,4.85-5.1S210.36,159.66,211,162.29ZM210.15,163.25c0-2.44-1.98-4.42-4.41-4.42s-4.42,1.98-4.42,4.42,1.98,4.41,4.42,4.41S210.15,165.68,210.15,163.25Z" />
              <path fill="currentColor" d="M208.07,165.98c-1.79.36-1.42-2.52-3.29-2.43l-.03,2.42h-.79s-.01-5.48-.01-5.48l2.36-.02c.77,0,1.56.54,1.67,1.19.15.91-.21,1.71-1.41,1.93L208.07,165.98ZM206.96,162.79c.19-.38.14-1.43-.21-1.47l-1.96-.22-.05,1.93L206.96,162.79Z" />
              <path fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="14" d="M183.22,1.5c6.75,1.14,12.64,6.43,12.64,13.63v167.22c0,7.13-5.84,12.57-12.72,13.64H14.13c-6.55-.99-11.7-5.73-12.63-12.28V13.78C2.44,7.15,7.62,2.56,14.05,1.5h169.17Z" />
              </svg>
                {contatti.linkedin.etichetta}
              </span>}
        </li>
      </ul>
    </div>

    <!-- ===== Pagine del sito ===== -->
    <nav class="footer__gruppo footer__gruppo--naviga" aria-label="Pagine del sito">
      <h2 class="footer__titolo">Naviga</h2>

      <ul class="footer__voci">
        {contatti.pagine.map((voce) => (
          <li><a href={voce.url}>{voce.etichetta}</a></li>
        ))}
      </ul>
    </nav>

    <!-- ===== Dati e informativa ===== -->
    <div class="footer__gruppo footer__gruppo--info">
      <h2 class="footer__titolo">Info</h2>

      <ul class="footer__voci">
        <li>{contatti.sede}</li>
        <li>{contatti.partitaIva}</li>
        <li>
          {/* Finché url è vuoto resta testo spento: meglio di un link
              che non porta da nessuna parte. */}
          {contatti.privacy.url
            ? <a href={contatti.privacy.url}>{contatti.privacy.etichetta}</a>
            : <span class="footer__attesa">{contatti.privacy.etichetta}</span>}
        </li>
      </ul>
    </div>

    <a class="footer__cta" href="/lavoriamo">progettiamo<br />il tuo sito</a>

    <p class="footer__copyright">{contatti.copyright}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 50px 40px;
    /* min-height e non height: su schermi bassi il contenuto può
       crescere invece di uscire dal riquadro */
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    background-color: #F1D8B9;
  }

  /* Mascotte, tre colonne di link, bottone. Il copyright sta su una
     riga sua, in fondo. La riga dei link si prende lo spazio che
     avanza (1fr), così il copyright finisce a filo del footer. */
  .footer__griglia {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 79px auto auto auto 1fr;
    grid-template-areas:
      'mascotte contatti naviga info cta'
      'copy     copy     copy   copy cta';
    grid-template-rows: auto 1fr;
    column-gap: 44px;
    row-gap: 60px;
    align-items: start;
  }

  .footer__mascotte {
    grid-area: mascotte;
    display: block;
    width: 79px;
  }

  .footer__mascotte img {
    width: 100%;
    height: auto;
    transform: scaleX(-1);   /* specchiata, come nel design */
    transition: transform 0.2s ease;
  }

  .footer__mascotte:hover img { transform: scaleX(-1) translateY(-4px); }

  .footer__gruppo--contatti { grid-area: contatti; }
  .footer__gruppo--naviga   { grid-area: naviga; }
  .footer__gruppo--info     { grid-area: info; }

  .footer__titolo {
    font-family: var(--f-accent);
    font-size: 24px;
    font-weight: 400;
    color: var(--c-nero);
    margin-bottom: 24px;
  }

  .footer__voci {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--f-testo);
    font-size: var(--t-corpo);
    color: var(--c-nero);
  }

  .footer__voci a,
  .footer__voci span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer__voci a:hover { text-decoration: underline; }

  /* Voce in attesa di collegamento: si legge, ma non finge di essere
     cliccabile. */
  .footer__attesa {
    opacity: 0.55;
    cursor: default;
  }

  /* Stessa altezza per tutte e tre, larghezza libera: fissare
     entrambe schiaccerebbe le icone con proporzioni diverse. */
  .footer__voci svg {
    height: 18px;
    width: auto;
    flex-shrink: 0;
  }

  /* Il bottone grande: stessa forma di quello dell'hero, corpo 48px */
  .footer__cta {
    grid-area: cta;
    justify-self: end;
    align-self: start;
    padding: 5px 8px;
    font-family: var(--f-accent);
    font-size: 48px;
    line-height: 1.2;
    color: var(--c-terracotta);
    background: var(--c-sfondo);
    border: 1px solid var(--c-bordo);
    filter: drop-shadow(-7px 7px 0 var(--c-ombra-bottone));
    transition: transform 0.15s ease;
  }

  .footer__cta:hover { transform: translate(-2px, 2px); }

  .footer__copyright {
    grid-area: copy;
    align-self: end;        /* a filo del fondo del footer */
    margin-top: 40px;
    font-family: var(--f-testo);
    font-size: 12px;
    color: var(--c-nero);
  }

  /* ---------- Il bottone non ci sta più in riga ----------
     Con tre colonne di link il limite si alza: sotto i 1200px il
     bottone va a capo e le colonne respirano. */
  @media (max-width: 1200px) {
    .footer__griglia {
      grid-template-columns: 79px repeat(3, minmax(0, 1fr));
      grid-template-areas:
        'mascotte contatti naviga info'
        'cta      cta      cta    cta'
        'copy     copy     copy   copy';
      grid-template-rows: auto auto 1fr;
      column-gap: 32px;
      row-gap: 40px;
    }

    .footer__cta {
      justify-self: start;
      font-size: clamp(26px, 4.4vw, 48px);
    }
  }

  /* ---------- Schermi stretti: tutto incolonnato ---------- */
  @media (max-width: 640px) {
    .footer__griglia {
      grid-template-columns: 1fr;
      grid-template-areas:
        'mascotte'
        'contatti'
        'naviga'
        'info'
        'cta'
        'copy';
      grid-template-rows: auto auto auto auto auto 1fr;
      row-gap: 28px;
      column-gap: 0;
    }

    .footer__titolo { margin-bottom: 16px; }
  }
</style>
