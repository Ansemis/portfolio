---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base titolo="Pagina non trovata — Andrea Messina" descrizione="Questa pagina non esiste.">
  <article class="errore">
    <div class="contenitore">
      <Navbar />

      <div class="errore__corpo">
        <div class="errore__testo">
          <h1 class="titolone">404</h1>
          <p class="errore__frase">Questa pagina non esiste.<br />Anselmo l'ha cercata ovunque.</p>

          <div class="errore__azioni">
            <a class="btn-contorno" href="/">torna alla home</a>
            <a class="btn-contorno" href="/#progetti">vedi i progetti</a>
          </div>
        </div>

        <img
          class="errore__anselmo"
          src="/img/anselmo-dubbio.webp"
          alt="Anselmo perplesso"
          width="500"
          height="500"
          fetchpriority="high"
        />
      </div>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .errore { padding-block: 50px 100px; }

  .errore__corpo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6%;
    flex-wrap: wrap;
    margin-top: 60px;
    min-height: 50vh;
  }

  .errore__testo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .errore__frase {
    font-family: var(--f-testo);
    font-size: var(--t-testo);
    line-height: 1.45;
    color: var(--c-testo);
  }

  .errore__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 8px;
  }

  /* stesso bottone dell'hero */
  .btn-contorno {
    display: inline-block;
    padding: 8px 12px;
    font-family: var(--f-accent);
    font-size: var(--t-bottone);
    line-height: 1.2;
    color: var(--c-terracotta);
    background: var(--c-sfondo);
    border: 1px solid var(--c-bordo);
    filter: drop-shadow(-7px 7px 0 var(--c-ombra-bottone));
    transition: transform 0.15s ease;
  }

  .btn-contorno:hover { transform: translate(-2px, 2px); }

  .errore__anselmo {
    width: clamp(180px, 28vw, 340px);
    height: auto;
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 760px) {
    .errore__corpo { flex-direction: column-reverse; gap: 32px; margin-top: 32px; }
    .errore__anselmo { width: min(55vw, 240px); }
  }
</style>
