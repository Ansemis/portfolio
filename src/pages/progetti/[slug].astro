---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Etichetta from '../../components/Etichetta.astro';
import Comparsa from '../../components/Comparsa.astro';
import { progetti } from '../../data/progetti.js';

// Una pagina per ogni progetto dell'elenco in progetti.js
export function getStaticPaths() {
  return progetti.map((progetto, i) => ({
    params: { slug: progetto.slug },
    props: {
      progetto,
      precedente: progetti[i - 1] ?? progetti[progetti.length - 1],
      prossimo:   progetti[i + 1] ?? progetti[0],
    },
  }));
}

const { progetto, precedente, prossimo } = Astro.props;
---

<Base
  titolo={progetto.titoloSeo ?? `${progetto.titolo} — Andrea Messina`}
  descrizione={progetto.descrizione}
  immagine={progetto.anteprima}
  immagineAlt={progetto.anteprimaAlt}
>
  <article class="caso">
    <!-- ============================================================
         La sequenza a schermi impilati (solo da 901px in su).
         I pannelli immagine restano inchiodati in alto; quello che
         viene dopo scorre sopra di loro e li copre. I pannelli di
         testo non sono inchiodati, così possono superare l'altezza
         dello schermo quando il testo è lungo.
         ============================================================ -->
    <div class="sequenza">

      <!-- 1 — prima schermata: titolo, mascotte, obiettivo, strategia -->
      <section class="pannello pannello--testo pannello--testata">
        <div class="contenitore">
          <Navbar />

          <header class="testata">
            <h1 class="caso__titolo">{progetto.titolo}</h1>

            <img
              class="testata__eroe"
              src={progetto.eroe.immagine}
              alt={progetto.eroe.alt}
              width="541"
              height="665"
              fetchpriority="high"
              decoding="async"
            />

            <div class="testata__intro">
              <Comparsa direzione="sinistra">
                <div class="voce">
                  <Etichetta come="h2" testo="obiettivo" rotazione={-2} />
                  <p class="caso__testo">{progetto.obiettivo}</p>
                </div>
              </Comparsa>

              <Comparsa direzione="sinistra" ritardo={100}>
                <div class="voce">
                  <Etichetta come="h2" testo="strategia" rotazione={2} />
                  <p class="caso__testo">{progetto.strategia}</p>
                </div>
              </Comparsa>
            </div>
          </header>
        </div>
      </section>

      <!-- 2 — le schermate, una per pannello. Ogni voce è { src, alt }:
           l'alt sta nei dati perché descrive quella immagine, e senza
           di esso chi non vede non ha accesso alle prove del lavoro. -->
      {progetto.schermate.map((v) => (
        <section class="pannello pannello--immagine">
          {v.src
            ? <img
                src={v.src}
                srcset={`${v.src.replace('.webp', '-1200.webp')} 1200w, ${v.src} 1900w`}
                sizes="(max-width: 900px) 88vw, 100vw"
                alt={v.alt} loading="lazy" decoding="async" />
            : <div class="segnaposto"><span>immagine in arrivo</span></div>}
        </section>
      ))}

      <!-- 3 — criticità e soluzioni, insieme in una schermata -->
      <section class="pannello pannello--testo pannello--caso">
        <div class="contenitore">
          <section class="blocco blocco--criticita">
            <Comparsa direzione="sinistra" class="blocco__slot">
              <img class="blocco__anselmo" src="/img/anselmo-criticita.webp"
                   alt="" width="400" height="500" loading="lazy" />
            </Comparsa>
            <Comparsa direzione="destra" ritardo={90} class="blocco__slot blocco__slot--largo">
              <div class="blocco__corpo">
                <Etichetta come="h2" testo="criticità" rotazione={-3} />
                <p class="caso__testo">{progetto.criticita}</p>
              </div>
            </Comparsa>
          </section>

          <section class="blocco blocco--soluzioni">
            <Comparsa direzione="destra" class="blocco__slot">
              <img class="blocco__anselmo" src="/img/anselmo-positivita.webp"
                   alt="" width="400" height="500" loading="lazy" />
            </Comparsa>
            <Comparsa direzione="sinistra" ritardo={90} class="blocco__slot blocco__slot--largo">
              <div class="blocco__corpo">
                <Etichetta come="h2" testo="soluzioni" rotazione={2} />
                <p class="caso__testo">{progetto.soluzioni}</p>
              </div>
            </Comparsa>
          </section>
        </div>
      </section>

      <!-- 4 — i dettagli, una per pannello -->
      {progetto.dettagli.map((v) => (
        <section class="pannello pannello--immagine">
          {v.src
            ? <img
                src={v.src}
                srcset={`${v.src.replace('.webp', '-1200.webp')} 1200w, ${v.src} 1900w`}
                sizes="(max-width: 900px) 88vw, 100vw"
                alt={v.alt} loading="lazy" decoding="async" />
            : <div class="segnaposto"><span>immagine in arrivo</span></div>}
        </section>
      ))}

      <!-- 5 — la vetrina del logo, dove c'è -->
      {progetto.vetrinaLogo && (
        <section class="pannello pannello--immagine">
          <div class="vetrina">
            <img class="vetrina__sfondo" src={progetto.vetrinaLogo.sfondo}
                 alt={`Simbolo di ${progetto.titolo}`} loading="lazy" />

            <div class="vetrina__destra">
              <img class="vetrina__simbolo" src={progetto.vetrinaLogo.simbolo}
                   alt="" loading="lazy" />
              <img class="vetrina__logotipo" src={progetto.vetrinaLogo.logotipo}
                   alt={`Logotipo di ${progetto.titolo}`} loading="lazy" />
            </div>
          </div>
        </section>
      )}

      <!-- 6 — conclusioni: l'ultima schermata che sale -->
      <section class="pannello pannello--testo pannello--finale">
        <div class="contenitore">
          <section class="blocco blocco--conclusioni">
            <Comparsa direzione="basso" class="blocco__slot blocco__slot--largo">
              <div class="blocco__corpo">
                <Etichetta come="h2" testo="conclusioni" rotazione={-2} />
                <p class="caso__testo">{progetto.conclusioni}</p>
              </div>
            </Comparsa>
          </section>
        </div>
      </section>
    </div>

    <div class="contenitore">
      <!-- ============ STRUMENTI: Anselmo col pennello + loghi =========== -->
      <section class="strumenti">
        <div class="strumenti__riga">
        <img class="strumenti__anselmo" src="/img/anselmo-strumento.webp"
             alt="" width="279" height="350" loading="lazy" />

        <ul class="strumenti__elenco">
          {progetto.strumenti.map((s) => (
            <li>
              {s.logo
                ? <img src={s.logo} alt={s.nome} loading="lazy" />
                : <span class="strumenti__nome">{s.nome}</span>}
            </li>
          ))}
        </ul>
        </div>

        <div class="strumenti__etichetta">
          <Etichetta come="h2" testo="strumenti utilizzati" rotazione={-2} />
        </div>
      </section>

      <!-- ============ PRECEDENTE / PROSSIMO ============================= -->
      <nav class="salto" aria-label="Altri progetti">
        <a class="salto__link" href={`/progetti/${precedente.slug}`}
           aria-label={`Progetto precedente: ${precedente.titolo}`}>
          <img src="/img/anselmo-freccia.webp" alt="" width="199" height="250" loading="lazy" />
          <Etichetta testo="progetto precedente" rotazione={-2} />
        </a>

        <a class="salto__link salto__link--destra" href={`/progetti/${prossimo.slug}`}
           aria-label={`Prossimo progetto: ${prossimo.titolo}`}>
          <img src="/img/anselmo-freccia.webp" alt="" width="199" height="250" loading="lazy" />
          <Etichetta testo="prossimo progetto" rotazione={2} />
        </a>
      </nav>
    </div>
  </article>

</Base>

<style>
  .caso { padding-block: 3% 80px; }

  .caso__testo {
    font-family: var(--f-testo);
    font-size: var(--t-caso);
    line-height: 1.45;
    color: var(--c-testo);
  }

  /* ---------- TESTATA ----------
     Le percentuali ricalcano le coordinate del Figma su tela 1440. */
  .testata {
    position: relative;
    margin-top: 4%px;
  }

  .caso__titolo {
    position: relative;
    z-index: 2;
    white-space: nowrap;
    font-family: var(--f-display);
    font-size: var(--t-progetto);
    font-weight: 400;
    line-height: 1.1;
    color: var(--c-terracotta);
    text-shadow: var(--ombra-titolo);
  }

  .testata__eroe {
    position: absolute;
    right: 0;
    top: 110px;
    width: 41%;      /* 541 / 1320 */
    max-width: 541px;
    height: auto;
    z-index: 0;
  }

  .testata__intro {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 90px;
    width: 36%;      /* 478 / 1320 */
    margin-left: 12%;
    padding-top: 90px;
    padding-bottom: 120px;
  }

  .voce {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  /* ---------- BLOCCHI CON ANSELMO ----------
     Immagine e testo affiancati, mai sovrapposti: il testo
     deve restare leggibile. */
  .blocco {
    display: flex;
    width: 75%;
    margin-inline: auto;   /* centra il blocco nella pagina */
    align-items: center;
    justify-content: center;
    gap: 60px;
    margin-top: 140px;
  }

  /* Le Comparsa avvolgono immagine e testo: sono loro, ora, i figli
     diretti del blocco flex, quindi portano le proporzioni.
     Servono :global() perché quei contenitori appartengono al
     componente Comparsa, e gli stili di Astro sono isolati per
     componente: senza, la regola non li raggiungerebbe. Resta
     comunque circoscritta ai .blocco di questa pagina. */
  .blocco :global(.blocco__slot) { flex: 0 0 26%; }
  .blocco :global(.blocco__slot--largo) { flex: 1 1 auto; min-width: 0; }

  .blocco__anselmo {
    width: 100%;
    height: auto;
  }

  .blocco__corpo {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  /* criticità: immagine a sinistra, testo a destra.
     Anselmo va specchiato per guardare verso il testo. */
  .blocco--criticita .blocco__anselmo { transform: scaleX(-1); }

  /* soluzioni: testo a sinistra, immagine a destra */
  .blocco--soluzioni { flex-direction: row-reverse; }

  /* conclusioni: solo testo, rientrato */
  .blocco--conclusioni .blocco__corpo {
    width: 60%;
    max-width: 60%;
    margin-inline: auto;
  }

  /* ---------- PANNELLI: regole di base ----------
     Sotto i 901px non c'è nessuna coreografia: i pannelli sono
     blocchi normali, uno sotto l'altro. La sequenza a schermi
     impilati vive tutta nel media query in fondo al file. */
  .pannello--immagine {
    margin-top: 56px;
    padding-inline: var(--margine-lato);
  }

  .pannello--immagine img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--c-etichetta);   /* colore di attesa al posto del testo */
  }

  /* Riquadro vuoto, stesse proporzioni degli screen (650x347) */
  .segnaposto {
    width: 100%;
    aspect-ratio: 650 / 347;
    display: grid;
    place-items: center;
    border: 2px dashed var(--c-bordo);
    background: var(--c-etichetta);
    font-family: var(--f-testo);
    font-size: var(--t-corpo);
    color: var(--c-bordo);
  }

  /* ---------- VETRINA DEL LOGO ----------
     Proporzioni prese dal Figma: sfondo 361px, simbolo 236px,
     logotipo 593px su tela da 1440. */
  .vetrina {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3%;
    margin-top: 110px;
  }

  .vetrina__sfondo {
    width: 27%;
    height: auto;
  }

  .vetrina__destra {
    width: 45%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .vetrina__simbolo {
    width: 40%;
    height: auto;
  }

  .vetrina__logotipo {
    width: 100%;
    height: auto;
  }

  /* ---------- STRUMENTI ---------- */
  .strumenti { margin-top: 160px; }

  .strumenti__riga {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 70px;
  }

  .strumenti__anselmo {
    flex: 0 0 18%;
    width: 18%;
    height: auto;
  }

  .strumenti__elenco {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }

  /* I loghi arrivano ritagliati stretti e con proporzioni molto diverse:
     due sono icone quadrate, gli altri quattro sono marchi con il nome
     scritto. Pareggiarli in altezza farebbe dominare i più lunghi, quindi
     limito anche la larghezza: così un marchio lungo si abbassa da solo e
     il peso visivo resta simile. */
  .strumenti__elenco img {
    height: auto;
    width: auto;
    max-height: 50px;
    max-width: 200px;
  }

  .strumenti__nome {
    font-family: var(--f-accent);
    font-size: var(--t-bottone);
    color: var(--c-testo);
  }

  .strumenti__etichetta {
    display: flex;
    justify-content: center;
    margin-top: 50px;
  }

  /* ---------- PRECEDENTE / PROSSIMO ---------- */
  .salto {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 180px;
  }

  .salto__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .salto__link--destra { align-items: flex-end; }

  .salto__link img {
    width: 199px;
    height: auto;
    transition: transform 0.2s ease;
  }

  /* la freccia di destra guarda dall'altra parte */
  .salto__link--destra img { transform: scaleX(-1); }
  .salto__link:hover img { transform: translateY(-8px); }
  .salto__link--destra:hover img { transform: scaleX(-1) translateY(-8px); }

  /* ---------- Schermi stretti ---------- */
  @media (max-width: 900px) {
    .caso__titolo { white-space: normal; }   /* puo' andare a capo */

    .testata {
      display: flex;
      flex-direction: column;
      gap: 24px;
      margin-top: 36px;
    }

    .testata__eroe {
      position: static;
      width: min(70vw, 420px);
      align-self: center;
    }

    .testata__intro {
      width: 100%;
      margin-left: 0;
      padding-top: 0;
      padding-bottom: 0;
      gap: 48px;
    }

    /* immagine sopra, testo sotto, su entrambi i blocchi */
    .blocco,
    .blocco--soluzioni {
      flex-direction: column;
      width: 100%;
      align-items: flex-start;
      gap: 24px;
      margin-top: 80px;
    }

    .blocco :global(.blocco__slot),
    .blocco :global(.blocco__slot--largo) { flex: 0 0 auto; width: 100%; }

    .blocco :global(.blocco__slot:has(.blocco__anselmo)) {
      width: min(58vw, 300px);
      align-self: center;
    }

    .blocco--conclusioni .blocco__corpo {
      width: 100%;
      max-width: 100%;
    }

    /* strumenti incolonnati */
    .strumenti { margin-top: 90px; }

    .strumenti__riga {
      flex-direction: column;
      gap: 28px;
    }

    .strumenti__anselmo { flex: 0 0 auto; width: min(48vw, 220px); }

    .strumenti__elenco { align-items: center; }

    .strumenti__elenco img { max-height: 38px; max-width: 150px; }

    /* vetrina del logo */
    .vetrina {
      flex-direction: column;
      align-items: center;
      gap: 28px;
      margin-top: 70px;
    }

    .vetrina__sfondo { width: min(60vw, 280px); }
    .vetrina__destra { width: min(78vw, 400px); }

    /* precedente / prossimo */
    .salto { margin-top: 90px; gap: 16px; }
    .salto__link img { width: min(28vw, 140px); }
  }

  @media (max-width: 560px) {
    .salto { flex-direction: column; align-items: center; gap: 44px; }
    .salto__link, .salto__link--destra { align-items: center; }
  }

  /* ================================================================
     LA SEQUENZA A SCHERMI IMPILATI — solo da 901px in su.

     Come funziona: i pannelli immagine sono "sticky" in alto, quindi
     restano inchiodati mentre si scorre; il pannello successivo,
     che ha uno sfondo pieno, sale e li copre. Da qui l'effetto di
     una schermata che compare sopra la precedente.

     I pannelli di testo NON sono sticky, di proposito: un testo
     lungo supererebbe l'altezza dello schermo e, da inchiodato,
     la parte in fondo diventerebbe irraggiungibile. Sono però
     "relative", perché un elemento non posizionato finirebbe
     sotto le immagini sticky invece che sopra.
     ================================================================ */
  @media (min-width: 901px) {
    .caso { padding-top: 0; }

    .sequenza { position: relative; }

    /* sfondo pieno su tutti: senza, si vedrebbe in trasparenza
       il pannello rimasto inchiodato sotto */
    .pannello {
      background: var(--c-sfondo);
    }

    .pannello--testo {
      /* Le entrate laterali partono da 80px di scostamento: con un
         margine laterale del 6% la colonna larga sporge finche' la
         finestra sta sotto i 1333px. clip taglia senza creare un
         contenitore di scorrimento, quindi gli sticky non si rompono. */
      overflow-x: clip;
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
    }

    .pannello--testo > .contenitore { width: 100%; }

    .pannello--immagine {
      position: sticky;
      top: 0;
      height: 100vh;
      margin-top: 0;
      padding-inline: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* contain e non cover: queste sono schermate di siti, tagliarne
       i bordi significherebbe tagliare contenuto. Per il taglio al
       vivo basta cambiare contain in cover. */
    .pannello--immagine img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: transparent;
    }

    .pannello--immagine .segnaposto {
      width: min(70vw, 900px);
      height: auto;
    }

    /* ---- prima schermata ---- */
    /* La navbar resta in cima alla schermata; titolo, mascotte e testi
       si centrano nello spazio che avanza. Senza stretch il contenitore
       si centrerebbe in blocco e la navbar scenderebbe con lui. */
    .pannello--testata { align-items: stretch; }

    .pannello--testata > .contenitore {
      display: flex;
      flex-direction: column;
      padding-top: 20px;
    }

    .pannello--testata .testata {
      width: 100%;
      margin-block: auto;
    }

    .pannello--testata .testata__intro {
      padding-top: 40px;
      padding-bottom: 0;
      gap: 56px;
    }

    /* la mascotte non deve sporgere oltre lo schermo */
    .pannello--testata .testata__eroe {
      top: 50%;
      transform: translateY(-40%);
      width: auto;
      max-width: 41%;
      max-height: 62vh;
    }

    /* ---- criticità e soluzioni nella stessa schermata ---- */
    .pannello--caso .blocco {
      width: 100%;
      margin-top: 0;
      gap: 40px;
    }

    .pannello--caso .blocco + .blocco { margin-top: 5vh; }

    /* Mascotte più piccole: qui devono starci due blocchi in una
       schermata sola. La seconda riga non è ridondante: --largo porta
       anche la classe .blocco__slot, quindi senza di essa la regola
       qui sopra restringerebbe pure la colonna del testo. */
    .pannello--caso .blocco :global(.blocco__slot) { flex: 0 0 15%; }
    .pannello--caso .blocco :global(.blocco__slot--largo) { flex: 1 1 auto; min-width: 0; }

    /* ---- conclusioni ---- */
    .pannello--finale .blocco { margin-top: 0; }

    /* ---- vetrina del logo ---- */
    .pannello--immagine .vetrina {
      margin-top: 0;
      width: 100%;
      max-height: 78vh;
      padding-inline: var(--margine-lato);
    }

    .pannello--immagine .vetrina__sfondo { max-height: 78vh; }
  }
</style>
