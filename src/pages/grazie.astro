---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base
  titolo="Messaggio ricevuto — Andrea Messina"
  descrizione="Grazie per avermi scritto: ti rispondo entro 3 giorni lavorativi."
>
  <article class="grazie">
    <div class="contenitore">
      <Navbar />

      <div class="grazie__corpo">
        <div class="grazie__testo">
          <h1 class="titolone">ricevuto!</h1>

          <p class="grazie__frase">
            Il tuo messaggio è arrivato. Ti rispondo entro
            <strong>3 giorni lavorativi</strong> con un preventivo, oppure con
            due domande se mi serve capire meglio.
          </p>

          <p class="grazie__nota">
            Controlla anche lo spam: a volte la prima mail finisce lì.
          </p>

          <div class="grazie__azioni">
            <a class="btn-contorno" href="/">torna alla home</a>
            <a class="btn-contorno" href="/#progetti">intanto guarda i progetti</a>
          </div>
        </div>

        <img
          class="grazie__anselmo"
          src="/img/anselmo-idea.webp"
          alt="Anselmo soddisfatto"
          width="500"
          height="500"
          fetchpriority="high"
        />
      </div>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .grazie { padding-block: 50px 100px; }

  .grazie__corpo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6%;
    flex-wrap: wrap;
    margin-top: 60px;
    min-height: 50vh;
  }

  .grazie__testo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 52ch;
  }

  .grazie__frase {
    font-family: var(--f-testo);
    font-size: var(--t-testo);
    line-height: 1.45;
    color: var(--c-testo);
  }

  .grazie__nota {
    font-family: var(--f-minuto);
    font-size: var(--t-corpo);
    color: var(--c-testo);
    opacity: 0.8;
  }

  .grazie__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 8px;
  }

  .btn-contorno {
    display: inline-block;
    padding: 8px 12px;
    font-family: var(--f-accent);
    font-size: var(--t-bottone);
    line-height: 1.2;
    color: var(--c-terracotta);
    background: var(--c-sfondo);
    border: 1px solid var(--c-bordo);
    filter: drop-shadow(-7px 7px 0 var(--c-ombra-bottone));
    transition: transform 0.15s ease;
  }

  .btn-contorno:hover { transform: translate(-2px, 2px); }

  .grazie__anselmo {
    width: clamp(180px, 28vw, 340px);
    height: auto;
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 760px) {
    .grazie__corpo { flex-direction: column-reverse; gap: 32px; margin-top: 32px; }
    .grazie__anselmo { width: min(55vw, 240px); }
  }
</style>
